qt4-webkit:
    debian: libqtwebkit-dev
    ubuntu:
        '18.04,20.04': libqtwebkit-dev
        default: ignore

python-yaml:
    debian,ubuntu: python3-yaml
    opensuse: python-yaml
    gentoo: dev-python/pyyaml

python-markdown:
    debian,ubuntu: python3-markdown
    opensuse: python3-markdown

curl4-openssl:
    ubuntu,debian: ["libcurl4-openssl-dev"]
    msys: libcurl-devel

curl4-gnutls:
    ubuntu,debian: ["libcurl4-gnutls-dev"]
